# UNSOLD (repo codename: Atlas) — environment template.
# Names and dummy values only. Never put real project IDs, secrets, or tokens here.
# Copy to `.env` for local development. Production values come from the Cloud Run service environment.

# --- Runtime mode -------------------------------------------------------------
# demo        -> local/demo behavior, synthetic data labels, demo-only routes enabled
# production  -> demo routes refused; full Google Cloud configuration required
APP_MODE=demo

# --- Google Cloud (required when APP_MODE=production) -------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_DB=(default)

# --- Gemini / embeddings (used from Stage 3: intent search + explanations) ----
# Verify current model IDs and regional availability in the official docs before use.
GEMINI_MODEL=REPLACE_WITH_CURRENT_FAST_MODEL_ID
# Optional stronger model for difficult explanation/review tasks; leave empty if unused.
GEMINI_MODEL_STRONG=
EMBED_MODEL=REPLACE_WITH_CURRENT_EMBEDDING_MODEL_ID
# Must match the embedding model's supported output dimension AND the Firestore vector index.
# Do not assume a value; verify both together.
EMBED_DIM=768

# --- Feature flags (enable only when the stage is implemented and tested) -----
ENABLE_DLP=false
ENABLE_APP_CHECK=false

# --- Product limits -----------------------------------------------------------
# Retention window (days) for user-owned records carrying `expires_at`.
DATA_RETENTION_DAYS=30
# Maximum length of a catalogue search query.
MAX_QUERY_CHARS=300
RATE_LIMIT_PER_MINUTE=20

# --- Local serving ------------------------------------------------------------
# Directory of the built frontend SPA. The Docker image overrides this.
# WEB_DIST=../web/dist

# --- Demo-only ----------------------------------------------------------------
# Optional fixed secret for signing demo-mode tokens. Leave empty to use a
# process-derived secret (tokens then reset when the server restarts).
# Never set this in production; demo routes do not exist there.
# DEV_TOKEN_SECRET=
